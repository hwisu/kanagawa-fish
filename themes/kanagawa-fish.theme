# Kanagawa Fish Theme (fish)
# A fish-themed variation of the Kanagawa color palette

# Syntax Highlighting with fish-themed descriptions
fish_color_normal DCD7BA         # Sand color
fish_color_command 7FB4CA        # Clear water blue
fish_color_keyword 957FB8        # Jellyfish purple
fish_color_quote 76946A          # Seaweed
fish_color_redirection A3D4D5    # Surface water
fish_color_end DCA561            # Sea star
fish_color_error C34043          # Coral
fish_color_param FF9E3B          # Clownfish orange
fish_color_comment 727169        # Pebble
fish_color_selection --background=2D4F67    # Medium ocean blue
fish_color_search_match --background=2D4F67 # Medium ocean blue
fish_color_operator 6A9589       # Teal seaweed
fish_color_escape 658594         # Blue-gray fish
fish_color_autosuggestion 54546D # Water surface
fish_color_cancel E82424         # Tropical fish red
fish_color_option 76946A         # Seaweed

# Prompt - optimized for underwater feel
fish_color_cwd DCA561            # Sea star
fish_color_user 957FB8           # Jellyfish purple
fish_color_host 7FB4CA           # Clear water blue

# Completion Pager
fish_pager_color_progress 727169     # Pebble
fish_pager_color_prefix A3D4D5       # Surface water
fish_pager_color_completion DCD7BA   # Sand color
fish_pager_color_description 54546D  # Water surface
fish_pager_color_selected_background --background=2D4F67 # Medium ocean blue
